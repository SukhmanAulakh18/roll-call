# Single-container web deploy: whole Roll Call stack in one process, UI served by control on $PORT.
FROM node:22-alpine AS ui
WORKDIR /app/ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY contracts /app/contracts
COPY ui ./
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY . .
COPY --from=ui /app/ui/dist ui/dist
ENV NODE_ENV=production HOST=0.0.0.0 PORT=7100
EXPOSE 7100
HEALTHCHECK CMD wget -qO- http://127.0.0.1:${PORT}/healthz || exit 1
CMD ["node", "scripts/serve.ts", "--ui", "ui/dist"]
