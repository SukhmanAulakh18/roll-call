{
 "uid": "rollcall-slos",
 "title": "Roll Call — SLOs",
 "tags": [
  "rollcall"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "10s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Decision latency p50 / p95 / p99 (target p99 <= 50 ms)",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(rollcall_gateway_decision_seconds_bucket[1m])))",
     "legendFormat": "p50",
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(rollcall_gateway_decision_seconds_bucket[1m])))",
     "legendFormat": "p95",
     "range": true
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(rollcall_gateway_decision_seconds_bucket[1m])))",
     "legendFormat": "p99",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "title": "Verdicts per second",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (verdict) (rate(rollcall_gateway_decisions_total[1m]))",
     "legendFormat": "{{verdict}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "title": "Burn rate, 1 h (page above 14.4)",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "slo:burn_rate:1h",
     "legendFormat": "{{slo}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 14.4
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "title": "Error budget remaining, 30 d (1 = untouched, 0 = frozen)",
   "type": "bargauge",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "slo:error_budget_remaining:ratio",
     "legendFormat": "{{slo}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient"
   }
  },
  {
   "id": 5,
   "title": "Time to contain p95 (target <= 30 s)",
   "type": "stat",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(rollcall_control_time_to_contain_seconds_bucket[1h])))",
     "legendFormat": "p95 1h",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Unregistered agents running (must be 0)",
   "type": "stat",
   "gridPos": {
    "x": 8,
    "y": 16,
    "w": 8,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(rollcall_control_unregistered_running)",
     "legendFormat": "unregistered",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "title": "Receipts vs decisions per second",
   "type": "timeseries",
   "gridPos": {
    "x": 16,
    "y": 16,
    "w": 8,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(rollcall_gateway_decisions_total[1m]))",
     "legendFormat": "decisions",
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(rollcall_gateway_receipts_total[1m]))",
     "legendFormat": "receipts",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  }
 ]
}